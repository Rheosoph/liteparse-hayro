{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    // Type checking only — tsup owns emit (see tsup.config.ts). Keeping this
    // noEmit prevents a bare `tsc` from producing an ESM-only dist/.
    "noEmit": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
